# Copy to .env and fill in. Never commit .env.

# ---------- Which model answers? ----------
# auto  = cloud APIs first, local Ollama as the last resort
# api   = cloud APIs only          local = Ollama only (nothing leaves your machine). Good for testing.
LLM_PREFERENCE=auto

# 1) Gemini. Key: https://aistudio.google.com/apikey   (leave empty to skip)
GOOGLE_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite


# ---------- Records database (Supabase) ----------
# Leave empty to keep records in a local SQLite file (fine for local testing).
# On a free host, paste the Supabase *Session pooler* URI here (Dashboard -> Connect). URL-encode special characters in the password.
DATABASE_URL=
REBUILD_CASE_INDEX_ON_START=true   # re-embed saved consultations at start-up (the vector index is lost when a free host restarts)

# ---------- Speech to text ----------
# Voice recordings are transcribed locally with Whisper. tiny/base/small/medium: bigger = better and slower.
WHISPER_MODEL=base
WHISPER_LANG=en          # "auto" to detect (Hindi, Kannada, ...)
# Optional Google Cloud Speech key file (mount ./secrets in docker-compose.yml):
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/service-account.json

# ---------- Emergency numbers shown on the call buttons ----------
EMERGENCY_NUMBER=112
AMBULANCE_NUMBER=108
EMERGENCY_LLM_TIMEOUT=25     # seconds the emergency modes wait for the AI before relying on the built-in steps

# ---------- Knowledge base ----------
AUTO_INGEST=true             # embed new or changed files in knowledge/ at every start
RETRIEVAL_K=4
MAX_RETRIEVAL_ROUNDS=2

# ---------- Security: set these before putting the app on the internet ----------
APP_USER=admin
APP_PASSWORD=

# ---------- Deployment ----------
PORT=7860                    # the port the app listens on inside the container
APP_PORT=8000
APP_BIND=0.0.0.0             # use 127.0.0.1 when Caddy (HTTPS) is in front
DOMAIN=localhost             # your real domain for HTTPS, e.g. copilot.example.com
